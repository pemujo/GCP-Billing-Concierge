# -----------------------------------------------------------------------------
# GCP Billing Concierge - Environment Variables Blueprint
# Copy this file to '.env' and fill in your values.
# IMPORTANT: Never commit your actual '.env' file to version control.
# -----------------------------------------------------------------------------

# --- Gemini Enterprise Agent Platform & Agent Configuration ---
# Project where the agent and its resources reside.
GOOGLE_CLOUD_PROJECT="your-project-id"
# Regional location for Agent Runtime and Cloud Scheduler (e.g., "us-central1")
GOOGLE_CLOUD_REGION="us-central1"
# Location for Vertex AI Gemini model routing ("global" recommended for optimal availability and throughput)
GOOGLE_CLOUD_LOCATION="global"
# Execution Identity Strategy: "agent_identity" (Keyless native identity, default & recommended) or "service_account"
IDENTITY_TYPE="agent_identity"
# Optional: Service account email (only required if IDENTITY_TYPE="service_account")
AGENT_SERVICE_ACCOUNT="gcp-billing-concierge-sa@your-project-id.iam.gserviceaccount.com"
GEMINI_MODEL="gemini-2.5-flash"
# Optional: Custom agent display / service name (defaults to "GCP_billing_concierge")
# AGENT_NAME="GCP_billing_concierge"
# Optional: Agent description for Gemini Enterprise and Agent Runtime
AGENT_DESCRIPTION="FinOps billing concierge for Google Cloud cost analysis, anomaly detection, and automated spend monitoring."
# Optional: Secret Manager secret name for storing deployed Agent ID (defaults to <agent-name>-agent-id)
# AGENT_ID_SECRET_NAME="billing-concierge-agent-id"

# --- Billing Data Source (BigQuery) ---
# Details for your existing BQ Billing Export.
# If using sample data, these will be populated by 'scripts/setup_billing_data.py'.
BILLING_EXPORT_PROJECT_ID="your-billing-export-project"
BILLING_EXPORT_DATASET="billing_export_dataset"
BILLING_EXPORT_TABLE="gcp_billing_export_v1_XXXXXX"
# Optional: Location of BigQuery billing dataset (defaults to auto-detect, e.g. "US" or "EU")
# BIGQUERY_LOCATION="US"

# --- FinOps Security & User OAuth Configuration ---
# Set to 'true' to execute BigQuery queries under the calling user's OAuth credentials.
# Only users with IAM access (roles/bigquery.dataViewer) on the billing dataset will be allowed to query data.
ENABLE_USER_OAUTH=true
# Require valid user OAuth credentials for all user queries (rejects unauthenticated requests with 401/403)
REQUIRE_USER_OAUTH=true
# Gemini Enterprise Authorization ID (matches Discovery Engine authorization resource name).
# Defaults dynamically to <clean-agent-name>-oauth (or "billing-ge-oauth" for "GCP_billing_concierge").
# AUTH_ID="billing-ge-oauth"
# Key used to store/retrieve user OAuth token in session state or request context (defaults to AUTH_ID)
# EXTERNAL_ACCESS_TOKEN_KEY="billing-ge-oauth"

# OAuth 2.0 Web Client credentials for interactive login in ADK Web (http://127.0.0.1:8000/dev-ui/)
# Note: Ensure 'http://127.0.0.1:8000' and 'http://localhost:8000' are added to Authorized Redirect URIs in GCP Console.
# Also ensure your browser allows pop-ups from 127.0.0.1:8000.
OAUTH_CLIENT_ID="813632901865-56im6tq89mi155irntl6jd5fq6g8hnl2.apps.googleusercontent.com"
OAUTH_CLIENT_SECRET=""

# --- Internal Agent Settings ---
# These variables ensure the ADK communicates correctly with Gemini Enterprise Cloud backend.
# Do not change these unless you are an advanced user.
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true
GOOGLE_GENAI_USE_VERTEXAI=1


